# Maintainer: Baki <karasoglu.bakican@gmail.com>
# Contributor: PureSend Contributors

pkgname=puresend-bin
pkgver=2.0.5
pkgrel=1
pkgdesc="End-to-end encrypted peer-to-peer file transfer for the terminal (libp2p)"
arch=('x86_64')
url="https://puresend.madebybaki.com"
license=('GPL-3.0-only')
provides=('puresend')
conflicts=('puresend')
# The release archive itself, by version: the same file and digest as the
# release's checksums.txt. An unversioned download URL changes content
# under the same name with every release, and pkgver stops meaning anything.
source_x86_64=("puresend-${pkgver}-x86_64.tar.gz::https://github.com/Baaaki/PureSend/releases/download/v${pkgver}/puresend_${pkgver}_linux_x86_64.tar.gz"
               "puresend.desktop"
               "puresend.svg")
sha256sums_x86_64=('9e8b8b7494c3825a8e315a3af2f8b60ab8b19f5b798ed412d7d7490b7020e9dc'
                   'SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/puresend" "${pkgdir}/usr/bin/puresend"
    if [ -f "${srcdir}/puresend.desktop" ]; then
        install -Dm644 "${srcdir}/puresend.desktop" "${pkgdir}/usr/share/applications/puresend.desktop"
    fi
    if [ -f "${srcdir}/puresend.svg" ]; then
        install -Dm644 "${srcdir}/puresend.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/puresend.svg"
    fi
}

